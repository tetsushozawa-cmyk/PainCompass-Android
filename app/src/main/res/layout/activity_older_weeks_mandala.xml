


<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/olderWeeksTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="13〜26週の曼荼羅"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/olderWeeksPeriodText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="記録を読み込み中"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fillViewport="false">

            <com.tetsushozawa.paincompass.MandalaMapView
                android:id="@+id/olderWeeksMapView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </HorizontalScrollView>

        <TextView
            android:id="@+id/olderWeeksRecordsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="記録一覧"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/olderWeeksBackButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="元の曼荼羅に戻る"
            android:textAllCaps="false"
            android:backgroundTint="@color/mandala_button"
            android:textColor="@color/white" />

    </LinearLayout>

</ScrollView>
